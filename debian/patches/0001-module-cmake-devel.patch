Description: Make sdrpp_module.cmake usable for out-of-tree plugin builds.
 .
 When building a plugin against the installed sdrpp-dev package (rather
 than in-tree via add_subdirectory), the sdrpp_core CMake target from
 core/CMakeLists.txt does not exist, so target_link_libraries() on it
 fails. This patch creates an IMPORTED target pointing at the installed
 shared library instead, carrying all the public include directories
 sdrpp_core normally exposes (core headers, ImGui, the GLFW backend,
 and bundled libcorrect), so out-of-tree plugins get the same include
 paths as in-tree ones.
Author: <ваше ім'я> <ваш email>
Forwarded: not-needed
--- a/sdrpp_module.cmake
+++ b/sdrpp_module.cmake
@@ -1,7 +1,20 @@
 # Get needed values depending on if this is in-tree or out-of-tree
 if (NOT SDRPP_CORE_ROOT)
-    set(SDRPP_CORE_ROOT "/usr/include/sdrpp_core/src/")
+    set(SDRPP_CORE_ROOT "/usr/include/sdrpp")
 endif ()
+
+if (NOT SDRPP_BACKEND_ROOT)
+    set(SDRPP_BACKEND_ROOT "/usr/include/sdrpp-backend-glfw")
+endif ()
+
+if (NOT SDRPP_LIBCORRECT_ROOT)
+    set(SDRPP_LIBCORRECT_ROOT "/usr/include/sdrpp-libcorrect")
+endif ()
+
+if (NOT SDRPP_MODULES_ROOT)
+    set(SDRPP_MODULES_ROOT "/usr/include/sdrpp-modules")
+endif ()
+
 if (NOT SDRPP_COMPILER_FLAGS)
     # Compiler flags
     if (${CMAKE_BUILD_TYPE} MATCHES "Debug")
@@ -25,10 +38,26 @@
     endif()
 endif ()
 
+# When building out-of-tree against an installed SDR++ (e.g. the Debian
+# sdrpp-dev package), the sdrpp_core CMake target from core/CMakeLists.txt
+# does not exist, since we never add_subdirectory("core") here. Create an
+# imported target carrying the same public include dirs instead.
+if (NOT TARGET sdrpp_core)
+    find_library(SDRPP_CORE_LIBRARY NAMES sdrpp_core)
+    if (NOT SDRPP_CORE_LIBRARY)
+        message(FATAL_ERROR "libsdrpp_core not found; is sdrpp-dev installed?")
+    endif ()
+    add_library(sdrpp_core SHARED IMPORTED)
+    set_target_properties(sdrpp_core PROPERTIES
+        IMPORTED_LOCATION "${SDRPP_CORE_LIBRARY}"
+        INTERFACE_INCLUDE_DIRECTORIES
+            "${SDRPP_CORE_ROOT};${SDRPP_CORE_ROOT}/imgui;${SDRPP_BACKEND_ROOT};${SDRPP_BACKEND_ROOT}/imgui;${SDRPP_LIBCORRECT_ROOT}")
+endif ()
+
 # Created shared lib and link to core
 add_library(${PROJECT_NAME} SHARED ${SRC})
 target_link_libraries(${PROJECT_NAME} PRIVATE sdrpp_core)
-target_include_directories(${PROJECT_NAME} PRIVATE "${SDRPP_CORE_ROOT}")
+target_include_directories(${PROJECT_NAME} PRIVATE "${SDRPP_CORE_ROOT}" "${SDRPP_CORE_ROOT}/imgui")
 set_target_properties(${PROJECT_NAME} PROPERTIES PREFIX "")
 
 # Set compile arguments
