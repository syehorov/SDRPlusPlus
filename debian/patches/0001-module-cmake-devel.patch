--- a/sdrpp_module.cmake
+++ b/sdrpp_module.cmake
@@ -1,15 +1,44 @@
 # Get needed values depending on if this is in-tree or out-of-tree
 if (NOT SDRPP_CORE_ROOT)
     set(SDRPP_CORE_ROOT "@SDRPP_CORE_ROOT@")
 endif ()
 
+if (NOT SDRPP_BACKEND_ROOT)
+    set(SDRPP_BACKEND_ROOT "@SDRPP_BACKEND_ROOT@")
+endif ()
+
+if (NOT SDRPP_LIBCORRECT_ROOT)
+    set(SDRPP_LIBCORRECT_ROOT "@SDRPP_LIBCORRECT_ROOT@")
+endif ()
+
+if (NOT SDRPP_MODULES_ROOT)
+    set(SDRPP_MODULES_ROOT "@SDRPP_MODULES_ROOT@")
+endif ()
+
 if (NOT SDRPP_MODULE_COMPILER_FLAGS)
     set(SDRPP_MODULE_COMPILER_FLAGS @SDRPP_MODULE_COMPILER_FLAGS@)
 endif ()
 
+if (NOT TARGET sdrpp_core)
+    find_library(SDRPP_CORE_LIBRARY NAMES sdrpp_core)
+    if (NOT SDRPP_CORE_LIBRARY)
+        message(FATAL_ERROR "libsdrpp_core not found; is sdrpp-dev installed?")
+    endif ()
+    add_library(sdrpp_core SHARED IMPORTED)
+    set_target_properties(sdrpp_core PROPERTIES
+        IMPORTED_LOCATION "${SDRPP_CORE_LIBRARY}"
+        INTERFACE_INCLUDE_DIRECTORIES
+            "${SDRPP_CORE_ROOT};${SDRPP_CORE_ROOT}/imgui;${SDRPP_BACKEND_ROOT};${SDRPP_BACKEND_ROOT}/imgui;${SDRPP_LIBCORRECT_ROOT}")
+endif ()
+
 # Created shared lib and link to core
 add_library(${PROJECT_NAME} SHARED ${SRC})
 target_link_libraries(${PROJECT_NAME} PRIVATE sdrpp_core)
-target_include_directories(${PROJECT_NAME} PRIVATE "${SDRPP_CORE_ROOT}/src/")
 set_target_properties(${PROJECT_NAME} PROPERTIES PREFIX "")
 
 # Set compile arguments
 target_compile_options(${PROJECT_NAME} PRIVATE ${SDRPP_MODULE_COMPILER_FLAGS})
 
 # Install directives
 install(TARGETS ${PROJECT_NAME} DESTINATION lib/sdrpp/plugins)
 