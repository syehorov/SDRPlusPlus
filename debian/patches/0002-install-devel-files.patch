--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -403,6 +403,34 @@
 # Create module cmake file
 configure_file(${CMAKE_SOURCE_DIR}/sdrpp_module.cmake ${CMAKE_CURRENT_BINARY_DIR}/sdrpp_module.cmake @ONLY)
 
+install(FILES ${CMAKE_SOURCE_DIR}/sdrpp_module.cmake
+        DESTINATION lib/cmake/sdrpp)
+
+# Core headers needed to build out-of-tree plugins
+install(DIRECTORY ${CMAKE_SOURCE_DIR}/core/src/
+        DESTINATION include/sdrpp
+        FILES_MATCHING PATTERN "*.h")
+
+install(DIRECTORY ${CMAKE_SOURCE_DIR}/core/backends/glfw/
+        DESTINATION include/sdrpp-backend-glfw
+        FILES_MATCHING PATTERN "*.h")
+
+if (USE_INTERNAL_LIBCORRECT)
+    install(DIRECTORY ${CMAKE_SOURCE_DIR}/core/libcorrect/include/
+            DESTINATION include/sdrpp-libcorrect
+            FILES_MATCHING PATTERN "*.h")
+endif ()
+
+# Headers of every built-in module, for out-of-tree plugins that depend on
+# another module's interface header (e.g. radio_interface.h)
+install(DIRECTORY
+            ${CMAKE_SOURCE_DIR}/decoder_modules
+            ${CMAKE_SOURCE_DIR}/misc_modules
+            ${CMAKE_SOURCE_DIR}/sink_modules
+            ${CMAKE_SOURCE_DIR}/source_modules
+        DESTINATION include/sdrpp-modules
+        FILES_MATCHING PATTERN "*.h")
+
 # Install directives
 install(TARGETS sdrpp DESTINATION bin)
 install(DIRECTORY ${CMAKE_SOURCE_DIR}/root/res/bandplans DESTINATION share/sdrpp)
